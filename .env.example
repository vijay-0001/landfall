# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# --- the mock merchant (Kiln & Co.) calls Landfall with its own API key: lf_test_ then 48 hex characters. Generate: python -c "import secrets;print('lf_test_'+secrets.token_hex(24))"
LANDFALL_KILN_API_KEY=
KILN_PUBLIC_URL=
KILN_ADDRESS=
# --- Landfall signs each quote (HMAC) so a merchant's server can verify the PayPal order against it. Generate: python -c "import secrets;print(secrets.token_hex(32))"
LANDFALL_SIGNING_KEY=
# --- Kiln (a merchant) uses its OWN PayPal sandbox app to fetch and capture orders. Landfall's API needs no PayPal credentials for the widget flow.
KILN_PAYPAL_CLIENT_ID=
KILN_PAYPAL_CLIENT_SECRET=
# --- Kiln's staff login for its mock back office (/login, then /admin). Local only: one shared account. The back office is OFF unless a password of 10+ characters is set.
KILN_ADMIN_USER=owner
KILN_ADMIN_PASSWORD=
# --- local only: open merchant sign-up (never on a hosted deployment)
# LANDFALL_ALLOW_SIGNUP=1
# --- PUBLIC SITES (all optional; unset means off, which is right for local runs) ---
# A password for the console (needs PUBLIC_URL too): visitors see a password page first. The shop's checkout widget and quote stay open.
# SITE_PASSWORD=
# AI rate limit per visitor (API key, or address if none): this many AI actions a minute, and this many in total per session window (default 24 hours).
# LANDFALL_AI_PER_MINUTE=10
# LANDFALL_AI_PER_SESSION=100
# Refuse approving rule proposals (they change the rate register and the ops console has no login of its own).
# LANDFALL_OPS_LOCKED=1
# Stricter, for a public site WITHOUT a password: a visitor with no API key can only read; no AI, no changes, no rule approvals.
# LANDFALL_DEMO_READONLY=1
# --- compose ---
POSTGRES_PASSWORD=
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost
# --- Unsplash API key (free): used only by a script that fetches product photos for the Kiln demo shop. Photos need credit to the photographer.
UNSPLASH_ACCESS_KEY=
