#!/usr/bin/env bash
# One entry point for CI, local and GitHub. Usage: scripts/ci [python|web|licences|all]
set -euo pipefail
cd "$(dirname "$0")/.."
PY="${PYTHON:-}"
if [ -z "$PY" ]; then
  if [ -x .venv/Scripts/python ]; then PY=.venv/Scripts/python; elif [ -x .venv/bin/python ]; then PY=.venv/bin/python; else PY=python; fi
fi
step() { printf '\n== %s\n' "$1"; }
target="${1:-all}"

run_python() {
  step "ruff"
  "$PY" -m ruff check .
  step "pytest (recorded fixtures only, live tests are opt-in)"
  "$PY" -m pytest -q
}
run_web() {
  if [ -f apps/web/package.json ]; then
    step "web: typecheck, lint, unit tests"
    (cd apps/web && npm run -s typecheck && npm run -s lint && npm run -s test)
  fi
}
run_licences() {
  step "licence scan: python"
  "$PY" -m piplicenses --format=json --output-file=.licences-py.json >/dev/null
  "$PY" scripts/licence_gate.py python .licences-py.json
  if [ -d apps/web/node_modules ]; then
    step "licence scan: npm (apps/web)"
    rm -f .licences-npm.json  # a failed scan must never be judged on a stale file
    (cd apps/web && npx --yes license-checker-rseidelsohn@4 --json --production=false --out ../../.licences-npm.json >/dev/null)
    "$PY" scripts/licence_gate.py npm .licences-npm.json
  fi
}
case "$target" in
  python) run_python ;;
  web) run_web ;;
  licences) run_licences ;;
  all) run_python; run_web; run_licences ;;
  *) echo "unknown target $target"; exit 2 ;;
esac
printf '\nCI OK (%s)\n' "$target"
